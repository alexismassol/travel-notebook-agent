{
  "name": "travel-notebook-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent conversationnel qui aide un voyageur à trouver sa destination et crée son carnet de voyage",
  "author": "Alexis Massol",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c green,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch --env-file-if-exists=.env src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "vite build && tsx --env-file-if-exists=.env src/server/index.ts",
    "test": "vitest run",
    "test:integration": "node --env-file-if-exists=.env ./node_modules/vitest/vitest.mjs run --config vitest.integration.config.ts",
    "scenarios": "tsx --env-file-if-exists=.env scripts/scenarios.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "check": "npm run lint && npm run typecheck && npm run check:docs && npm test",
    "visual-check": "tsx scripts/visual-check.ts",
    "check:docs": "node scripts/check-doc-refs.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.126.0",
    "@hono/node-server": "2.1.1",
    "hono": "4.13.8",
    "jspdf": "^4.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "concurrently": "9.2.4",
    "jsdom": "^29.1.1",
    "playwright": "1.60.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "vite": "8.3.0",
    "vitest": "4.1.11"
  }
}
